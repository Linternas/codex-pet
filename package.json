{
  "name": "codex-pet-mac",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.2",
    "dev:app": "pnpm run build:main && concurrently -k \"vite --host 127.0.0.2\" \"wait-on http://127.0.0.2:5173 && VITE_DEV_SERVER_URL=http://127.0.0.2:5173 electron .\"",
    "build:icon": "node scripts/build-app-icon.mjs",
    "start": "pnpm run build && electron .",
    "build": "pnpm run build:native && pnpm run build:main && vite build",
    "build:native": "node scripts/build-key-monitor.mjs && node scripts/build-updater.mjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "package:dmg": "pnpm run build:icon && pnpm run build && node scripts/package-dmg.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "import:guga": "pnpm run build:main && node dist-electron/scripts/import-pet.js guga"
  },
  "main": "electron-main.cjs",
  "dependencies": {
    "lucide": "^1.42.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.32",
    "concurrently": "^9.2.0",
    "electron": "^35.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
